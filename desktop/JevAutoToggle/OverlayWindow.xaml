<Window x:Class="JevCodexAutoToggle.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="68" Height="30"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Window.Resources>
        <SolidColorBrush x:Key="OffBackground" Color="#F7F8F7" />
        <SolidColorBrush x:Key="OffBorder" Color="#D7DAD7" />
        <SolidColorBrush x:Key="OffText" Color="#545A56" />
        <SolidColorBrush x:Key="OnBackground" Color="#EEF7F1" />
        <SolidColorBrush x:Key="OnBorder" Color="#8CC7A0" />
        <SolidColorBrush x:Key="OnText" Color="#176B38" />
        <SolidColorBrush x:Key="OnDot" Color="#23A455" />
        <SolidColorBrush x:Key="OffDot" Color="#A7ADA9" />
        <SolidColorBrush x:Key="ErrorBackground" Color="#FFF4F2" />
        <SolidColorBrush x:Key="ErrorBorder" Color="#E0A39B" />
        <SolidColorBrush x:Key="ErrorText" Color="#9B3428" />
    </Window.Resources>

    <Button x:Name="AutoButton"
            Padding="0"
            BorderThickness="0"
            Background="Transparent"
            Cursor="Hand"
            Click="AutoButton_OnClick">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Pill"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource OffBorder}"
                        Background="{DynamicResource OffBackground}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                 Width="7" Height="7"
                                 Margin="0,0,7,0"
                                 Fill="{DynamicResource OffDot}" />
                        <TextBlock x:Name="Label"
                                   Text="Auto"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OffText}" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Pill" Property="Opacity" Value="0.88" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Pill" Property="Opacity" Value="0.72" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
